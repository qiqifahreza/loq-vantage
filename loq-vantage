CTL_BIN = "/usr/bin/loq-vantage-ctl"
VPC_DIR = "/sys/bus/platform/devices/VPC2004:00"
HIDIOCSFEATURE_33 = 0xC0214806  # _IOWR('H', 0x06, 33)
ITE_VENDOR_ID = "0000048D"


def read_sys(path):
    try:
        with open(path, "r", encoding="utf-8") as f:
            return f.read().strip()
    except OSError:
        return None


def find_platform_profile_paths():
    for base in sorted(glob.glob("/sys/class/platform-profile/*")):
        name = read_sys(os.path.join(base, "name")) or ""
        prof = os.path.join(base, "profile")
        choices = os.path.join(base, "choices")
        if os.path.exists(prof) and ("lenovo" in name or "ideapad" in name):
            return prof, choices
    legacy_prof = "/sys/firmware/acpi/platform_profile"
    legacy_choices = "/sys/firmware/acpi/platform_profile_choices"
    if os.path.exists(legacy_prof):
        return legacy_prof, legacy_choices
    return None, None


def find_battery_dir():
    for bat in sorted(glob.glob("/sys/class/power_supply/BAT*")):
        if os.path.exists(os.path.join(bat, "capacity")):
            return bat
    return None


def find_rgb_candidates():
    """
    Cari semua node hidraw milik ITE (048D) dan urutkan berdasarkan kecocokan descriptor:
    Report ID 0xCC (85 cc) dan Usage Page 0xFF89 (06 89 ff).
    """
    candidates = []
    for dev in sorted(glob.glob("/sys/class/hidraw/hidraw*")):
        uevent = read_sys(os.path.join(dev, "device", "uevent")) or ""
        hid_id = ""
        for line in uevent.splitlines():
            if line.startswith("HID_ID="):
                hid_id = line.split("=", 1)[1].upper()
                break
        parts = hid_id.split(":")
        if len(parts) == 3 and parts[1] == ITE_VENDOR_ID:
            pid = parts[2][-4:]
            rdesc_path = os.path.join(dev, "device", "report_descriptor")
            rdesc = b""
            try:
                with open(rdesc_path, "rb") as f:
                    rdesc = f.read()
            except OSError:
                pass
            has_ff89 = b"\x06\x89\xff" in rdesc
            has_cc = b"\x85\xcc" in rdesc
            score = (2 if has_cc else 0) + (1 if has_ff89 else 0)
            dev_path = os.path.join("/dev", os.path.basename(dev))
            flags = []
            if has_cc:
                flags.append("0xCC")
            if has_ff89:
                flags.append("0xFF89")
            flag_str = "+".join(flags) if flags else "Generic"
            candidates.append((score, dev_path, f"{dev_path} (048D:{pid} • {flag_str})"))

    candidates.sort(key=lambda x: (-x[0], x[1]))
    return candidates


def build_rgb_packet(effect, speed, brightness, zones_rgb, wave_dir=0):
    buf = bytearray(33)
    buf[0] = 0xCC
    buf[1] = 0x16
    buf[2] = effect
    buf[3] = speed
    buf[4] = brightness
    for i in range(4):
        r, g, b = zones_rgb[i]
        buf[5 + i * 3] = r
        buf[6 + i * 3] = g
        buf[7 + i * 3] = b
    # Byte 18 (rtl) & Byte 19 (ltr) untuk efek Wave (0x04)
    if effect == 0x04:
        if wave_dir == 0:
            buf[19] = 0x01  # Kiri -> Kanan
        else:
            buf[18] = 0x01  # Kanan -> Kiri
    return buf


def send_rgb_packet_direct(hidraw_path, buf):
    fd = os.open(hidraw_path, os.O_RDWR)
    try:
        fcntl.ioctl(fd, HIDIOCSFEATURE_33, buf)
    finally:
        os.close(fd)


def get_nvidia_status():
    for dev in sorted(glob.glob("/sys/bus/pci/devices/*")):
        vendor = read_sys(os.path.join(dev, "vendor"))
        dev_class = read_sys(os.path.join(dev, "class")) or ""
        if vendor == "0x10de" and dev_class.startswith("0x03"):
            rstatus = read_sys(os.path.join(dev, "power/runtime_status"))
            if rstatus == "suspended":
                return "Tidur (D3cold — Hemat Daya)"
            try:
                out = subprocess.check_output(
                    [
                        "nvidia-smi",
                        "--query-gpu=name,temperature.gpu,utilization.gpu,power.draw,memory.used,memory.total",
                        "--format=csv,noheader,nounits",
                    ],
                    text=True,
                    timeout=2,
                    stderr=subprocess.DEVNULL,
                ).strip()
                if out:
                    name, temp, util, pwr, mem_u, mem_t = [x.strip() for x in out.split(",")]
                    return f"{name} | {temp}°C | Load {util}% | {pwr} W | VRAM {mem_u}/{mem_t} MiB"
            except Exception:
                return f"Aktif ({rstatus or 'unknown'}) — nvidia-smi tidak tersedia"
    return "Tidak terdeteksi / Hanya iGPU"


def get_cpu_telemetry():
    temps = []
    for hw in sorted(glob.glob("/sys/class/hwmon/hwmon*")):
        if read_sys(os.path.join(hw, "name")) == "coretemp":
            for t in sorted(glob.glob(os.path.join(hw, "temp*_input"))):
                val = read_sys(t)
                if val and val.isdigit():
                    temps.append(int(val) / 1000.0)
            break
    pkg_temp = f"{temps[0]:.0f}°C" if temps else "N/A"

    freqs = []
    for fpath in glob.glob("/sys/devices/system/cpu/cpu[0-9]*/cpufreq/scaling_cur_freq"):
        v = read_sys(fpath)
        if v and v.isdigit():
            freqs.append(int(v) / 1000.0)
    avg_freq = f"{sum(freqs)/len(freqs):.0f} MHz" if freqs else "N/A"
    return f"Suhu Paket: {pkg_temp}  |  Rata-rata Clock: {avg_freq}"


def get_fans_telemetry():
    """
    Cari sensor kipas di hwmon laptop (lenovo-wmi-other, lenovo_wmi_other, legion_hwmon, ideapad, acpi),
    atau fallback ke hwmon non-GPU yang memiliki fan*_input.
    """
    preferred = []
    fallback = []
    all_hwmons = []

    for hw in sorted(glob.glob("/sys/class/hwmon/hwmon*")):
        name = read_sys(os.path.join(hw, "name")) or "unknown"
        fans = sorted(glob.glob(os.path.join(hw, "fan*_input")))
        all_hwmons.append(f"{os.path.basename(hw)}:{name}")
        if not fans:
            continue
        lname = name.lower()
        entries = []
        for idx, fp in enumerate(fans, start=1):
            label = read_sys(fp.replace("_input", "_label")) or f"Fan {idx}"
            val = read_sys(fp)
            if val is not None:
                entries.append(f"{label}: {val} RPM")
        if not entries:
            continue
        if any(k in lname for k in ("lenovo", "legion", "ideapad", "thinkpad")):
            preferred.extend(entries)
        elif lname not in ("amdgpu", "nouveau", "nvidia"):
            fallback.extend([f"{e} ({name})" for e in entries])

    if preferred:
        return "  |  ".join(preferred), None
    if fallback:
        return "  |  ".join(fallback), None

    # Cek status parameter expose_all_fans pada lenovo_wmi_other
    exp_param = read_sys("/sys/module/lenovo_wmi_other/parameters/expose_all_fans")
    if exp_param == "N":
        hint = "lenovo_wmi_other aktif dengan expose_all_fans=N. Aktifkan di tab Perangkat lalu reboot."
    elif exp_param == "Y":
        hint = "BIOS NECN50WW tidak mengekspos tabel fan WMI ke kernel mainline (butuh lenovolegionlinux-dkms jika ingin baca RPM)."
    else:
        hint = f"Tidak ada fan*_input di hwmon ({', '.join(all_hwmons[:5])})."
    return "Sensor RPM tidak diekspos oleh kernel saat ini", hint


def get_battery_telemetry():
    bat = find_battery_dir()
    if not bat:
        return "Baterai tidak terdeteksi", "N/A", "unknown"

    cap = read_sys(os.path.join(bat, "capacity")) or "?"
    status = read_sys(os.path.join(bat, "status")) or "?"
    cycles = read_sys(os.path.join(bat, "cycle_count")) or "?"
    power_uw = read_sys(os.path.join(bat, "power_now"))
    watt_str = f"{int(power_uw) / 1_000_000:.1f} W" if power_uw and power_uw.isdigit() else "-"

    ef = read_sys(os.path.join(bat, "energy_full"))
    efd = read_sys(os.path.join(bat, "energy_full_design"))
    health_str = (
        f"{(int(ef) / int(efd)) * 100:.1f}%"
        if ef and efd and ef.isdigit() and efd.isdigit() and int(efd) > 0
        else "?"
    )

    mode = "unknown"
    ct_raw = read_sys(os.path.join(bat, "charge_types"))
    if ct_raw:
        for tok in ct_raw.split():
            if tok.startswith("[") and tok.endswith("]"):
                m = tok[1:-1]
                mode = {"Long_Life": "conservation", "Fast": "rapid"}.get(m, "standard")
    else:
        cval = read_sys(os.path.join(VPC_DIR, "conservation_mode"))
        if cval == "1":
            mode = "conservation"
        elif cval == "0":
            mode = "standard"

    line1 = f"{cap}% ({status})  •  Daya: {watt_str}"
    line2 = f"Kesehatan: {health_str}  •  Cycle Count: {cycles}"
    return line1, line2, mode


class LOQVantageWindow(Adw.ApplicationWindow):
    def __init__(self, app):
        super().__init__(application=app, title="LOQ Vantage")
        self.set_default_size(800, 700)
        self._updating_ui = False

        self.toast_overlay = Adw.ToastOverlay()
        toolbar_view = Adw.ToolbarView()

        header = Adw.HeaderBar()
        self.view_stack = Adw.ViewStack()
        switcher = Adw.ViewSwitcher(stack=self.view_stack, policy=Adw.ViewSwitcherPolicy.WIDE)
        header.set_title_widget(switcher)
        toolbar_view.add_top_bar(header)

        self.build_dashboard_page()
        self.build_power_page()
        self.build_keyboard_page()
        self.build_device_page()

        toolbar_view.set_content(self.view_stack)
        self.toast_overlay.set_child(toolbar_view)
        self.set_content(self.toast_overlay)

        self.refresh_state()
        GLib.timeout_add_seconds(2, self._on_timer)

    def show_toast(self, msg):
        self.toast_overlay.add_toast(Adw.Toast.new(msg))

    def run_ctl(self, args, on_done=None):
        def worker():
            cmd = [CTL_BIN] + args if os.geteuid() == 0 else ["pkexec", CTL_BIN] + args
            res = subprocess.run(cmd, capture_output=True, text=True)
            GLib.idle_add(self._handle_ctl_result, res, on_done)

        threading.Thread(target=worker, daemon=True).start()

    def _handle_ctl_result(self, res, on_done):
        if res.returncode != 0:
            err = res.stderr.strip() or f"Gagal (kode {res.returncode})"
            if "dismissed" not in err.lower():
                self.show_toast(f"Error: {err}")
        else:
            if on_done:
                on_done()
        self.refresh_state()

    # ---------------- PAGE 1: DASHBOARD ----------------
    def build_dashboard_page(self):
        page = Adw.PreferencesPage()

        sys_group = Adw.PreferencesGroup(title="Informasi Sistem")
        model = read_sys("/sys/class/dmi/id/product_version") or "Lenovo LOQ"
        sku = read_sys("/sys/class/dmi/id/product_name") or "83DV"
        bios = read_sys("/sys/class/dmi/id/bios_version") or "Unknown"

        self.row_model = Adw.ActionRow(title=f"{model} (Type {sku})", subtitle=f"BIOS: {bios}")
        self.lbl_profile_badge = Gtk.Label(label="-")
        self.lbl_profile_badge.add_css_class("pill")
        self.row_model.add_suffix(self.lbl_profile_badge)
        sys_group.add(self.row_model)
        page.add(sys_group)

        tel_group = Adw.PreferencesGroup(title="Telemetri Real-Time")
        self.row_cpu = Adw.ActionRow(title="Prosesor (CPU)", subtitle="Memuat...")
        self.row_gpu = Adw.ActionRow(title="Grafis Diskrit (NVIDIA GPU)", subtitle="Memuat...")
        self.row_fan = Adw.ActionRow(title="Kipas Pendingin", subtitle="Memuat...")
        self.row_bat = Adw.ActionRow(title="Baterai", subtitle="Memuat...")
        self.lbl_bat_health = Gtk.Label(label="")
        self.lbl_bat_health.add_css_class("dim-label")
        self.row_bat.add_suffix(self.lbl_bat_health)

        for r in (self.row_cpu, self.row_gpu, self.row_fan, self.row_bat):
            tel_group.add(r)
        page.add(tel_group)

        self.view_stack.add_titled_with_icon(page, "dashboard", "Dashboard", "computer-symbolic")

    # ---------------- PAGE 2: PERFORMA & DAYA ----------------
    def build_power_page(self):
        page = Adw.PreferencesPage()

        therm_group = Adw.PreferencesGroup(
            title="Mode Termal (Fn + Q)",
            description="Mengatur profil daya, kipas, dan warna indikator LED tombol power.",
        )
        self.profile_buttons = {}
        box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        box.set_homogeneous(True)
        box.set_margin_top(6)
        box.set_margin_bottom(6)

        modes = [
            ("low-power", "Quiet (Biru)"),
            ("balanced", "Balanced (Putih)"),
            ("performance", "Performance (Merah)"),
            ("custom", "Custom (Ungu)"),
        ]
        _, choices_path = find_platform_profile_paths()
        avail_choices = (read_sys(choices_path) or "low-power balanced performance").split()

        first_btn = None
        for key, label in modes:
            if key not in avail_choices and key == "custom":
                continue
            btn = Gtk.ToggleButton(label=label)
            if first_btn is None:
                first_btn = btn
            else:
                btn.set_group(first_btn)
            btn.connect("toggled", self.on_profile_toggled, key)
            self.profile_buttons[key] = btn
            box.append(btn)

        row_therm = Adw.ActionRow()
        row_therm.set_child(box)
        therm_group.add(row_therm)
        page.add(therm_group)

        bat_group = Adw.PreferencesGroup(
            title="Perawatan Baterai",
            description="Conservation Mode membatasi pengisian ~75-80% untuk memperpanjang umur baterai.",
        )
        self.combo_bat = Adw.ComboRow(
            title="Mode Pengisian Daya",
            model=Gtk.StringList.new(["Standard (100%)", "Conservation Mode (~80%)", "Rapid Charge (Cepat)"]),
        )
        self.combo_bat.connect("notify::selected", self.on_battery_mode_changed)
        bat_group.add(self.combo_bat)
        page.add(bat_group)

        wmi_attrs_dirs = glob.glob("/sys/class/firmware-attributes/lenovo-wmi-other*/attributes")
        if wmi_attrs_dirs:
            wmi_dir = wmi_attrs_dirs[0]
            wmi_group = Adw.PreferencesGroup(
                title="Custom Mode Tuning (lenovo-wmi-other)",
                description="Berlaku hanya saat Mode Termal disetel ke 'Custom'.",
            )
            important_attrs = [
                ("ppt_pl1_spl", "CPU Sustained Power Limit (PL1 / W)"),
                ("ppt_pl2_sppt", "CPU Slow Power Limit (PL2 / W)"),
                ("ppt_pl3_fppt", "CPU Fast Power Limit (PL3 / W)"),
                ("cpu_temp", "Batas Suhu CPU (°C)"),
                ("gpu_nv_ctgp", "GPU Configurable TGP (W)"),
                ("gpu_temp", "Batas Suhu GPU (°C)"),
            ]
            for attr_key, title in important_attrs:
                p = os.path.join(wmi_dir, attr_key)
                if not os.path.isdir(p):
                    continue
                cur = int(read_sys(os.path.join(p, "current_value")) or 0)
                min_v = int(read_sys(os.path.join(p, "min_value")) or 0)
                max_v = int(read_sys(os.path.join(p, "max_value")) or 150)
                step = int(read_sys(os.path.join(p, "scalar_increment")) or 1)
                if max_v <= min_v:
                    continue

                row = Adw.ActionRow(title=title, subtitle=f"Rentang: {min_v} – {max_v} (Saat ini: {cur})")
                spin = Gtk.SpinButton.new_with_range(min_v, max_v, max(1, step))
                spin.set_value(cur)
                spin.set_valign(Gtk.Align.CENTER)
                apply_btn = Gtk.Button(label="Terapkan")
                apply_btn.set_valign(Gtk.Align.CENTER)
                apply_btn.connect(
                    "clicked",
                    lambda _b, k=attr_key, s=spin: self.run_ctl(
                        ["wmi-attr", k, str(int(s.get_value()))],
                        lambda: self.show_toast(f"{k} diperbarui"),
                    ),
                )
                row.add_suffix(spin)
                row.add_suffix(apply_btn)
                wmi_group.add(row)
            page.add(wmi_group)

        self.view_stack.add_titled_with_icon(page, "power", "Performa & Daya", "power-profile-performance-symbolic")

