        )
        row_exp.add_suffix(btn_exp)
        fan_group.add(row_exp)
        page.add(fan_group)

        self.view_stack.add_titled_with_icon(page, "devices", "Perangkat", "preferences-system-symbolic")

    # ---------------- CALLBACKS & SYNC ----------------
    def _on_timer(self):
        self.refresh_state()
        return True

    def refresh_state(self):
        self._updating_ui = True
        try:
            self.row_cpu.set_subtitle(get_cpu_telemetry())
            self.row_gpu.set_subtitle(get_nvidia_status())
            fan_text, fan_hint = get_fans_telemetry()
            self.row_fan.set_subtitle(f"{fan_text} — {fan_hint}" if fan_hint else fan_text)

            bat_l1, bat_l2, bat_mode = get_battery_telemetry()
            self.row_bat.set_subtitle(bat_l1)
            self.lbl_bat_health.set_text(bat_l2)

            bat_idx = {"standard": 0, "conservation": 1, "rapid": 2}.get(bat_mode, 0)
            if self.combo_bat.get_selected() != bat_idx:
                self.combo_bat.set_selected(bat_idx)

            prof_path, _ = find_platform_profile_paths()
            cur_prof = read_sys(prof_path) if prof_path else "unknown"
            self.lbl_profile_badge.set_text((cur_prof or "unknown").upper())
            for k, btn in self.profile_buttons.items():
                if btn.get_active() != (k == cur_prof):
                    btn.set_active(k == cur_prof)

            for key, sw in self.device_switches.items():
                val = read_sys(os.path.join(VPC_DIR, key))
                if val in ("0", "1"):
                    active = val == "1"
                    if sw.get_active() != active:
                        sw.set_active(active)
        finally:
            self._updating_ui = False

    def on_profile_toggled(self, btn, key):
        if self._updating_ui or not btn.get_active():
            return
        self.run_ctl(["profile", key], lambda: self.show_toast(f"Mode diubah ke {key}"))

    def on_battery_mode_changed(self, row, _param):
        if self._updating_ui:
            return
        idx = row.get_selected()
        mode = {0: "standard", 1: "conservation", 2: "rapid"}.get(idx, "standard")
        self.run_ctl(["battery", mode], lambda: self.show_toast(f"Mode baterai: {mode}"))

    def on_device_switch_toggled(self, row, _param, key):
        if self._updating_ui:
            return
        val = "1" if row.get_active() else "0"
        self.run_ctl(["ideapad", key, val])

    def on_sync_zones(self, _btn):
        c0 = self.zone_buttons[0].get_rgba()
        for b in self.zone_buttons[1:]:
            b.set_rgba(c0)

    def on_apply_rgb(self, _btn):
        if not self.rgb_candidates:
            return
        effect_map = {0: 0x01, 1: 0x03, 2: 0x04, 3: 0x06, 4: 0x00}
        effect = effect_map.get(self.combo_rgb_effect.get_selected(), 0x01)
        speed = self.combo_rgb_speed.get_selected() + 1
        bright_sel = self.combo_rgb_bright.get_selected()
        wave_dir = self.combo_rgb_wave_dir.get_selected()

        if bright_sel == 0 or effect == 0x00:
            effect = 0x00
            brightness = 1
            zones = [(0, 0, 0)] * 4
        else:
            brightness = bright_sel  # 1=low, 2=high
            zones = []
            for b in self.zone_buttons:
                rgba = b.get_rgba()
                zones.append((
                    int(round(rgba.red * 255)),
                    int(round(rgba.green * 255)),
                    int(round(rgba.blue * 255)),
                ))

        buf = build_rgb_packet(effect, speed, brightness, zones, wave_dir=wave_dir)
        sel_idx = self.combo_rgb_dev.get_selected()

        # Susun urutan percobaan: node terpilih dulu, lalu kandidat 048D lainnya
        ordered = [(sel_idx, self.rgb_candidates[sel_idx][1])]
        for i, cand in enumerate(self.rgb_candidates):
            if i != sel_idx:
                ordered.append((i, cand[1]))

        last_err = None
        for idx, dev_path in ordered:
            try:
                send_rgb_packet_direct(dev_path, buf)
                if idx != sel_idx:
                    self.combo_rgb_dev.set_selected(idx)
                self.show_toast(f"RGB diterapkan via {dev_path}")
                return
            except PermissionError:
                # Fallback via helper root jika izin udev hidraw belum aktif
                self.run_ctl(
                    ["rgb", os.path.basename(dev_path), buf.hex()],
                    lambda p=dev_path: self.show_toast(f"RGB diterapkan via {p} (root)"),
                )
                return
            except OSError as e:
                last_err = f"{dev_path}: {e}"
                continue

        self.show_toast(f"Gagal mengirim RGB ({last_err})")


